# Android SDK location, change to your local path.
sdk.dir=C\:\\Users\\your_user\\AppData\\Local\\Android\\Sdk

# Recommended local backend mode for Android Emulator.
# Start backend first, then app calls http://10.0.2.2:8080/.
NEWS_BASE_URL=http://10.0.2.2:8080/
NEWS_API_KEY=
BACKEND_APP_TOKEN=change_this_demo_token
NEWS_API_DAILY_LIMIT=90
FIREBASE_WEB_CLIENT_ID=your_firebase_web_client_id.apps.googleusercontent.com

# Direct NewsAPI mode, only use for quick demo and do not publish API key in app.
# NEWS_BASE_URL=https://newsapi.org/
# NEWS_API_KEY=your_newsapi_key_here
